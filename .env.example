# Copy to .env and fill in from Firebase console -> Project settings -> Your apps (Web app).
# Leave the YOUR_ placeholders to run local-only: cloud requests are then refused before any network call.
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Only useful if Decoy is also hosted as a web page; the extension uses a debug token.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=YOUR_RECAPTCHA_ENTERPRISE_SITE_KEY

# Optional. Defaults to gemini-3.5-flash-lite.
VITE_CLOUD_MODEL=

# true = App Check debug token. The token itself is generated per browser profile and printed to the
# side panel console. Register it in Firebase console -> App Check. Do not commit it.
VITE_APP_CHECK_DEBUG=true
